# ===================================================================
# Office Visitor Management System - Environment Variables Template
# Copy this file to .env and configure your production credentials.
# NEVER commit the real .env file or production passwords to GitHub.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=visitor_management_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_secure_mysql_password
# Or full JDBC URL override:
# DB_URL=jdbc:mysql://localhost:3306/visitor_management_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# System Administrator Initial Account Setup
# (Used only on initial startup to seed the admin account with BCrypt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=System Administrator

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed origins (e.g. your production domain)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
